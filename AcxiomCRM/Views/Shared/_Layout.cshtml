@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var userRole = roles.FirstOrDefault() ?? "Guest";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Theme -->
    <link rel="stylesheet" href="~/css/acxiom-crm.css" asp-append-version="true" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <div id="app-wrapper">
            <!-- Sidebar -->
            <nav id="sidebar">
                <a asp-controller="Dashboard" asp-action="Index" class="brand">
                    <i class="bi bi-shield-check text-primary"></i>
                    <span>AcxiomCRM</span>
                </a>

                <div class="overflow-y-auto flex-grow-1 py-2">
                    <div class="nav-section">Main</div>
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(currentController == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Dashboard</span>
                    </a>

                    <div class="nav-section">CRM Core</div>
                    <a asp-controller="Customers" asp-action="Index" class="nav-link @(currentController == "Customers" ? "active" : "")">
                        <i class="bi bi-people"></i>
                        <span>Customers</span>
                    </a>
                    <a asp-controller="Leads" asp-action="Index" class="nav-link @(currentController == "Leads" ? "active" : "")">
                        <i class="bi bi-funnel"></i>
                        <span>Leads</span>
                    </a>
                    <a asp-controller="Opportunities" asp-action="Index" class="nav-link @(currentController == "Opportunities" ? "active" : "")">
                        <i class="bi bi-currency-dollar"></i>
                        <span>Opportunities</span>
                    </a>
                    <a asp-controller="FollowUps" asp-action="Index" class="nav-link @(currentController == "FollowUps" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i>
                        <span>Follow-Ups</span>
                    </a>
                    <a asp-controller="Activities" asp-action="Index" class="nav-link @(currentController == "Activities" ? "active" : "")">
                        <i class="bi bi-clock-history"></i>
                        <span>Activities</span>
                    </a>

                    <div class="nav-section">Analytics & Reports</div>
                    <a asp-controller="Reports" asp-action="Pipeline" class="nav-link @(currentController == "Reports" ? "active" : "")">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>Reports</span>
                    </a>

                    @if (User.IsInRole(SystemRoles.Admin))
                    {
                        <div class="nav-section">Administration</div>
                        <a asp-controller="Users" asp-action="Index" class="nav-link @(currentController == "Users" ? "active" : "")">
                            <i class="bi bi-person-gear"></i>
                            <span>User Management</span>
                        </a>
                        <a asp-controller="AuditLogs" asp-action="Index" class="nav-link @(currentController == "AuditLogs" ? "active" : "")">
                            <i class="bi bi-journal-text"></i>
                            <span>Audit Logs</span>
                        </a>
                    }
                </div>

                <!-- Sidebar Footer -->
                <div class="p-3 border-top border-secondary border-opacity-25 small text-secondary">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary bg-opacity-25 p-2 text-primary">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <div class="text-truncate">
                            <div class="text-white fw-semibold text-truncate" style="font-size: 0.85rem;">@(currentUser?.FullName ?? "User")</div>
                            <div class="badge bg-secondary bg-opacity-50 text-light" style="font-size: 0.65rem;">@userRole</div>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Content Area -->
            <div id="main-content">
                <!-- Top Navbar -->
                <header class="top-navbar">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebar-toggle" type="button">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <span class="fs-6 fw-semibold text-muted d-none d-sm-inline">
                            Enterprise Relationship Management System
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <span class="badge @(userRole == SystemRoles.Admin ? "bg-danger" : userRole == SystemRoles.Manager ? "bg-primary" : "bg-success") text-white role-badge">
                            <i class="bi bi-shield-lock me-1"></i> @userRole
                        </span>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle text-primary"></i>
                                <span class="d-none d-md-inline fw-semibold" style="font-size: 0.85rem;">@(currentUser?.FullName ?? "Account")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li>
                                    <h6 class="dropdown-header">Logged in as @currentUser?.Email</h6>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key me-2"></i> Change Password
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Log Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Body -->
                <main role="main" class="p-3 p-md-4 flex-grow-1">
                    <!-- Global Success / Error Alerts -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="bg-white border-top py-3 px-4 text-muted small d-flex flex-wrap justify-content-between align-items-center">
                    <div>&copy; @DateTime.UtcNow.Year AcxiomCRM — Customer Relationship Management System</div>
                    <div class="d-flex gap-3">
                        <span>ASP.NET Core 8 MVC</span>
                        <span>•</span>
                        <span>Entity Framework Core</span>
                        <span>•</span>
                        <a href="/api/customers" target="_blank" class="text-decoration-none">REST API</a>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Anonymous / Auth Container -->
        <main role="main" class="min-vh-100 d-flex flex-column justify-content-center py-4">
            @RenderBody()
        </main>
    }

    <!-- Standard Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle mobile sidebar
        document.getElementById('sidebar-toggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('show');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
