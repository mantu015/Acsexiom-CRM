@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.ViewModels.UserItemViewModel>
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">User & Role Management</h4>
        <p class="text-muted small mb-0">Control system users, assign primary roles, manage lockouts, and initiate password resets</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus me-1"></i> Add System User
    </a>
</div>

<!-- Search & Filter Card -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by name, email, or username..." value="@ViewBag.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="role" class="form-select" asp-items="ViewBag.Roles">
                    <option value="">All Roles</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email / Username</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Lockout</th>
                    <th>Created Date</th>
                    <th>Last Login</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var u in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@u.FullName</div>
                            </td>
                            <td>
                                <div>@u.Email</div>
                                <div class="text-muted small">@u.UserName</div>
                            </td>
                            <td>
                                <span class="badge @(u.Role == SystemRoles.Admin ? "bg-danger" : u.Role == SystemRoles.Manager ? "bg-primary" : "bg-success")">
                                    @u.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge-status @(u.IsActive ? "badge-active" : "badge-inactive")">
                                    @(u.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger">Locked Out (@u.FailedLoginCount fails)</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border">Normal</span>
                                }
                            </td>
                            <td>@u.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td>@(u.LastLoginDate?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@u.Id"><i class="bi bi-pencil me-2 text-primary"></i> Edit & Unlock</a></li>
                                        <li><a class="dropdown-item" asp-action="ResetPassword" asp-route-id="@u.Id"><i class="bi bi-key me-2 text-warning"></i> Reset Password</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item @(u.IsActive ? "text-danger" : "text-success")">
                                                    <i class="bi @(u.IsActive ? "bi-slash-circle" : "bi-check-circle") me-2"></i>
                                                    @(u.IsActive ? "Deactivate User" : "Activate User")
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                            No users found matching your filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
