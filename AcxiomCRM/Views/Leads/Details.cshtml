@model AcxiomCRM.ViewModels.LeadDetailsViewModel
@{
    var l = Model.Lead;
    ViewData["Title"] = $"{l.LeadName} - Lead Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h4 class="fw-bold mb-0">@l.LeadName</h4>
            <span class="badge bg-light text-dark border me-2">@l.LeadCode</span>
            <span class="badge-status @(l.Status == "Qualified" ? "badge-qualified" : l.Status == "Converted" ? "badge-converted" : "badge-active")">@l.Status</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        @if (!l.IsConverted)
        {
            <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-success btn-sm shadow-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer
            </a>
        }
        <a asp-controller="FollowUps" asp-action="Create" asp-route-relatedType="Lead" asp-route-relatedId="@l.LeadId" class="btn btn-warning btn-sm text-dark">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@l.LeadId" class="btn btn-light border btn-sm">
            <i class="bi bi-clock-history me-1"></i> Activity
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Lead Profile Card -->
    <div class="col-lg-4">
        <div class="crm-card">
            <div class="crm-card-header">
                <h6 class="mb-0 fw-bold"><i class="bi bi-funnel me-2 text-primary"></i> Lead Overview</h6>
            </div>
            <div class="crm-card-body">
                @if (l.IsConverted)
                {
                    <div class="alert alert-success p-2 small mb-3">
                        <i class="bi bi-check-circle-fill me-1"></i> Converted on @l.ConvertedDate?.ToString("yyyy-MM-dd")
                        @if (l.ConvertedCustomerId.HasValue)
                        {
                            <div class="mt-1">
                                Customer: <a asp-controller="Customers" asp-action="Details" asp-route-id="@l.ConvertedCustomerId.Value" class="fw-bold text-success text-decoration-underline">View Customer Record</a>
                            </div>
                        }
                    </div>
                }

                <div class="mb-3">
                    <label class="text-muted small">Company</label>
                    <div class="fw-semibold">@(l.CompanyName ?? "-")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Email Address</label>
                    <div><a href="mailto:@l.Email" class="text-decoration-none fw-semibold">@l.Email</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Phone Number</label>
                    <div><a href="tel:@l.Phone" class="text-decoration-none fw-semibold">@l.Phone</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Lead Source</label>
                    <div><span class="badge bg-light text-secondary border">@l.Source</span></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Priority</label>
                    <div>
                        <span class="badge @(l.Priority == "High" ? "bg-danger" : l.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">
                            @l.Priority
                        </span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Expected Value</label>
                    <div class="fs-5 fw-bold text-primary">$@l.ExpectedValue.ToString("N0")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Assigned Sales Executive</label>
                    <div class="fw-semibold text-primary">@(l.AssignedUser?.FullName ?? "Unassigned")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Captured Date</label>
                    <div class="small">@l.CreatedDate.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(l.Notes))
                {
                    <div class="pt-2 border-top">
                        <label class="text-muted small">Notes / History</label>
                        <p class="small text-secondary mb-0">@l.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Related Follow-Ups and Activities -->
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header p-0 border-bottom-0">
                <ul class="nav nav-tabs px-3 pt-2" id="leadTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-semibold" id="lead-followups-tab" data-bs-toggle="tab" data-bs-target="#lead-followups" type="button">
                            Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" id="lead-activities-tab" data-bs-toggle="tab" data-bs-target="#lead-activities" type="button">
                            Activities (@Model.Activities.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="crm-card-body">
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="lead-followups">
                        @if (Model.FollowUps.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var f in Model.FollowUps)
                                {
                                    <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-semibold small">@f.Subject</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                <span class="badge bg-light text-dark border me-1">@f.FollowUpType</span>
                                                @f.FollowUpDate.ToString("MMM dd, yyyy HH:mm") &bull; Status: <span class="badge-status @(f.Status == "Completed" ? "badge-completed" : "badge-planned")">@f.Status</span>
                                            </div>
                                        </div>
                                        @if (f.Status == "Planned")
                                        {
                                            <a asp-controller="FollowUps" asp-action="Complete" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-success">Mark Done</a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-calendar-check fs-2 text-secondary d-block mb-1"></i>
                                No follow-ups scheduled for this lead.
                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" id="lead-activities">
                        @if (Model.Activities.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var a in Model.Activities)
                                {
                                    <div class="list-group-item px-0 py-2 d-flex align-items-start gap-3">
                                        <div class="badge bg-light text-dark border p-2">@a.ActivityType</div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold small">@a.Subject</div>
                                            @if (!string.IsNullOrWhiteSpace(a.Description))
                                            {
                                                <div class="text-muted small">@a.Description</div>
                                            }
                                            <div class="text-muted" style="font-size: 0.72rem;">@a.ActivityDate.ToString("MMM dd, yyyy HH:mm")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-clock-history fs-2 text-secondary d-block mb-1"></i>
                                No activities recorded for this lead.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
