@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.Models.Entities.Lead>
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Leads</h4>
        <p class="text-muted small mb-0">Track prospect capture, qualification, assignment, and conversion</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add Lead
    </a>
</div>

<!-- Search & Filter Card -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by name, code, company..." value="@ViewBag.SearchTerm" />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(ViewBag.Status == "New")">New</option>
                    <option value="Contacted" selected="@(ViewBag.Status == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(ViewBag.Status == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(ViewBag.Status == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(ViewBag.Status == "Converted")">Converted</option>
                    <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="priority" class="form-select">
                    <option value="">All Priorities</option>
                    <option value="High" selected="@(ViewBag.Priority == "High")">High</option>
                    <option value="Medium" selected="@(ViewBag.Priority == "Medium")">Medium</option>
                    <option value="Low" selected="@(ViewBag.Priority == "Low")">Low</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="assignedTo" class="form-select" asp-items="ViewBag.SalesExecutives">
                    <option value="">All Sales Execs</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table">
            <thead>
                <tr>
                    <th>Lead Code</th>
                    <th>Lead Name</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Expected Value</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var l in Model.Items)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border fw-semibold">@l.LeadCode</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@l.LeadId" class="fw-semibold text-decoration-none text-primary">
                                    @l.LeadName
                                </a>
                            </td>
                            <td>@(l.CompanyName ?? "-")</td>
                            <td><span class="badge bg-light text-secondary border">@l.Source</span></td>
                            <td>
                                @if (l.Status == "New") { <span class="badge-status badge-new">New</span> }
                                else if (l.Status == "Contacted") { <span class="badge-status badge-contacted">Contacted</span> }
                                else if (l.Status == "Qualified") { <span class="badge-status badge-qualified">Qualified</span> }
                                else if (l.Status == "Converted") { <span class="badge-status badge-converted">Converted</span> }
                                else if (l.Status == "Lost") { <span class="badge-status badge-lost">Lost</span> }
                                else { <span class="badge-status badge-inactive">@l.Status</span> }
                            </td>
                            <td>
                                <span class="badge @(l.Priority == "High" ? "bg-danger" : l.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">
                                    @l.Priority
                                </span>
                            </td>
                            <td class="fw-semibold">$@l.ExpectedValue.ToString("N0")</td>
                            <td>@(l.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@l.LeadId"><i class="bi bi-eye me-2 text-primary"></i> View Details</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@l.LeadId"><i class="bi bi-pencil me-2 text-secondary"></i> Edit</a></li>
                                        @if (!l.IsConverted)
                                        {
                                            <li><a class="dropdown-item text-success fw-semibold" asp-action="Convert" asp-route-id="@l.LeadId"><i class="bi bi-arrow-repeat me-2"></i> Convert Lead</a></li>
                                        }
                                        <li><a class="dropdown-item" asp-controller="FollowUps" asp-action="Create" asp-route-relatedType="Lead" asp-route-relatedId="@l.LeadId"><i class="bi bi-calendar-plus me-2 text-warning"></i> Add Follow-Up</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@l.LeadId" method="post" onsubmit="return confirm('Are you sure you want to delete or discard this lead?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="bi bi-trash me-2"></i> Delete / Discard
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-funnel fs-1 d-block mb-2 text-secondary"></i>
                            No lead records found matching the criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
