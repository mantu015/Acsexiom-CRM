@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.Models.Entities.Customer>
@{
    ViewData["Title"] = "Customer Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Customers</h4>
        <p class="text-muted small mb-0">Manage customer accounts, contacts, and relationship records</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add Customer
    </a>
</div>

<!-- Search & Filter Card -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by name, code, email, phone, or company..." value="@ViewBag.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
                    <option value="Lead" selected="@(ViewBag.Status == "Lead")">Lead</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Customers Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table">
            <thead>
                <tr>
                    <th>Customer Code</th>
                    <th>Customer Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Sales Executive</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border fw-semibold">@c.CustomerCode</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@c.CustomerId" class="fw-semibold text-decoration-none text-primary">
                                    @c.CustomerName
                                </a>
                            </td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>
                                <span class="badge-status @(c.Status == "Active" ? "badge-active" : "badge-inactive")">
                                    @c.Status
                                </span>
                            </td>
                            <td>@(c.Owner?.FullName ?? "Unassigned")</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@c.CustomerId"><i class="bi bi-eye me-2 text-primary"></i> View Details</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@c.CustomerId"><i class="bi bi-pencil me-2 text-secondary"></i> Edit</a></li>
                                        <li><a class="dropdown-item" asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@c.CustomerId"><i class="bi bi-currency-dollar me-2 text-success"></i> Add Opportunity</a></li>
                                        <li><a class="dropdown-item" asp-controller="FollowUps" asp-action="Create" asp-route-relatedType="Customer" asp-route-relatedId="@c.CustomerId"><i class="bi bi-calendar-plus me-2 text-warning"></i> Add Follow-Up</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" onsubmit="return confirm('Are you sure you want to deactivate/delete this customer?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="bi bi-trash me-2"></i> Delete / Deactivate
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                            No customer records found matching the criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@ViewBag.Status">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@ViewBag.Status">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@ViewBag.Status">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
