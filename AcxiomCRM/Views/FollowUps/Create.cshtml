@model AcxiomCRM.ViewModels.FollowUpFormViewModel
@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-plus me-2 text-warning"></i> Schedule Follow-Up</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="RelatedType" class="form-label"></label>
                            <select asp-for="RelatedType" class="form-select" id="relTypeSelect" onchange="updateRecordDropdown()">
                                <option value="Customer">Customer</option>
                                <option value="Lead">Lead</option>
                                <option value="Opportunity">Opportunity</option>
                            </select>
                            <span asp-validation-for="RelatedType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RelatedId" class="form-label">Associated Record</label>
                            <select asp-for="RelatedId" class="form-select" id="relIdSelect">
                                <!-- Populated dynamically by javascript -->
                            </select>
                            <span asp-validation-for="RelatedId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label"></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Discuss revised quote terms" autofocus />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label"></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">Meeting (In-person / Virtual)</option>
                                <option value="Email">Email Follow-Up</option>
                                <option value="Task">Task / Milestone</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label"></label>
                            <input asp-for="FollowUpDate" class="form-control" type="datetime-local" min="@DateTime.Today.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Completed">Completed</option>
                                <option value="Missed">Missed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole(SystemRoles.Admin) || User.IsInRole(SystemRoles.Manager))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label"></label>
                                <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.SalesExecutives">
                                    <option value="">-- Assign to Current User --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Agenda or details to cover during follow-up..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Schedule Follow-Up</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const customers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<Customer>)ViewBag.Customers).Select(c => new { id = c.CustomerId, name = c.CustomerName })));
        const leads = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<Lead>)ViewBag.Leads).Select(l => new { id = l.LeadId, name = l.LeadName })));
        const opps = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<Opportunity>)ViewBag.Opportunities).Select(o => new { id = o.OpportunityId, name = o.OpportunityName })));

        const currentRelId = @Model.RelatedId;

        function updateRecordDropdown() {
            const relType = document.getElementById('relTypeSelect').value;
            const relSelect = document.getElementById('relIdSelect');
            relSelect.innerHTML = '';

            let list = [];
            if (relType === 'Customer') list = customers;
            else if (relType === 'Lead') list = leads;
            else if (relType === 'Opportunity') list = opps;

            list.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.id;
                opt.text = item.name;
                if (item.id === currentRelId) opt.selected = true;
                relSelect.appendChild(opt);
            });
        }
        updateRecordDropdown();
    </script>
}
