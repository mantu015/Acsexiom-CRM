@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.Models.Entities.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Follow-Ups</h4>
        <p class="text-muted small mb-0">Schedule and track calls, meetings, emails, and reminder tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Search & Filter Card -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search subject or related record..." value="@ViewBag.SearchTerm" />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(ViewBag.Status == "Planned")">Planned</option>
                    <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                    <option value="Missed" selected="@(ViewBag.Status == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                    <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                    <option value="Task" selected="@(ViewBag.Type == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="date" class="form-control" value="@ViewBag.Date" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Ups Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Type</th>
                    <th>Related To</th>
                    <th>Scheduled Date</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var f in Model.Items)
                    {
                        var isOverdue = f.Status == "Planned" && f.FollowUpDate < DateTime.UtcNow;
                        <tr class="@(isOverdue ? "table-danger bg-opacity-25" : "")">
                            <td>
                                <div class="fw-semibold text-dark">@f.Subject</div>
                                @if (!string.IsNullOrWhiteSpace(f.Remarks))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 320px;">@f.Remarks</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@f.FollowUpType</span>
                            </td>
                            <td>
                                @if (f.Customer != null)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary">Customer: @f.Customer.CustomerName</span>
                                }
                                else if (f.Lead != null)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info">Lead: @f.Lead.LeadName</span>
                                }
                                else if (f.Opportunity != null)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Opp: @f.Opportunity.OpportunityName</span>
                                }
                                else
                                {
                                    <span class="text-muted">@f.RelatedType #@f.RelatedId</span>
                                }
                            </td>
                            <td>
                                <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                    @f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")
                                </span>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">Overdue</span>
                                }
                            </td>
                            <td>
                                <span class="badge-status @(f.Status == "Completed" ? "badge-completed" : f.Status == "Missed" ? "badge-missed" : "badge-planned")">
                                    @f.Status
                                </span>
                            </td>
                            <td>@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    @if (f.Status == "Planned")
                                    {
                                        <a asp-action="Complete" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-success py-1 px-2" title="Mark Completed">
                                            <i class="bi bi-check2"></i> Done
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-warning text-dark py-1 px-2" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@f.FollowUpId" title="Reschedule">
                                            <i class="bi bi-calendar"></i>
                                        </button>
                                    }
                                    <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-light border py-1 px-2">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>

                                <!-- Reschedule Modal -->
                                <div class="modal fade text-start" id="rescheduleModal-@f.FollowUpId" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="Reschedule" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@f.FollowUpId" />
                                                <div class="modal-header">
                                                    <h6 class="modal-title fw-bold">Reschedule Follow-Up: @f.Subject</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label">New Date & Time</label>
                                                        <input type="datetime-local" name="newDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-ddTHH:mm")" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label">Reschedule Reason / Remarks</label>
                                                        <input type="text" name="remarks" class="form-control" placeholder="Client requested later time..." />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-sm btn-primary">Confirm Reschedule</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar2-check fs-1 d-block mb-2 text-secondary"></i>
                            No follow-ups found matching your filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
