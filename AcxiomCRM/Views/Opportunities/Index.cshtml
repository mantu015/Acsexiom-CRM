@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.Models.Entities.Opportunity>
@{
    ViewData["Title"] = "Opportunity Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Sales Opportunities</h4>
        <p class="text-muted small mb-0">Track pipeline stages, expected close dates, probabilities, and deals</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add Opportunity
    </a>
</div>

<!-- Search & Filter Card -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by deal name, code, customer..." value="@ViewBag.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="stage" class="form-select">
                    <option value="">All Pipeline Stages</option>
                    <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
                    <option value="Won" selected="@(ViewBag.Status == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Expected Close</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var opp in Model.Items)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border fw-semibold">@opp.OpportunityCode</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none text-primary">
                                    @opp.OpportunityName
                                </a>
                            </td>
                            <td>
                                @if (opp.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@opp.CustomerId" class="text-decoration-none text-dark">
                                        @opp.Customer.CustomerName
                                    </a>
                                }
                                else { <span>-</span> }
                            </td>
                            <td class="fw-bold text-dark">$@opp.Amount.ToString("N0")</td>
                            <td>
                                <span class="badge @(opp.Stage == "Won" ? "bg-success" : opp.Stage == "Lost" ? "bg-danger" : "bg-primary bg-opacity-75")">
                                    @opp.Stage
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span>@opp.Probability%</span>
                                    <div class="progress flex-grow-1" style="height: 6px; width: 45px;">
                                        <div class="progress-bar @(opp.Probability >= 70 ? "bg-success" : opp.Probability >= 40 ? "bg-primary" : "bg-warning")" style="width: @opp.Probability%"></div>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-semibold text-primary">$@opp.WeightedValue.ToString("N0")</td>
                            <td>
                                <span class="@(opp.Status == "Open" && opp.ExpectedCloseDate.Date < DateTime.Today ? "text-danger fw-semibold" : "")">
                                    @opp.ExpectedCloseDate.ToString("yyyy-MM-dd")
                                </span>
                            </td>
                            <td>@(opp.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@opp.OpportunityId"><i class="bi bi-eye me-2 text-primary"></i> View Details</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@opp.OpportunityId"><i class="bi bi-pencil me-2 text-secondary"></i> Edit</a></li>
                                        <li><a class="dropdown-item" asp-controller="FollowUps" asp-action="Create" asp-route-relatedType="Opportunity" asp-route-relatedId="@opp.OpportunityId"><i class="bi bi-calendar-plus me-2 text-warning"></i> Add Follow-Up</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@opp.OpportunityId" method="post" onsubmit="return confirm('Are you sure you want to delete this opportunity?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="bi bi-trash me-2"></i> Delete
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-currency-dollar fs-1 d-block mb-2 text-secondary"></i>
                            No opportunities found matching the criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
