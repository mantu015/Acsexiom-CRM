@model AcxiomCRM.ViewModels.OpportunityFormViewModel
@{
    ViewData["Title"] = $"Edit Opportunity - {Model.OpportunityCode}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-pencil me-2 text-primary"></i> Edit Opportunity</h5>
                    <span class="badge bg-light text-dark border">@Model.OpportunityCode</span>
                </div>
                <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-sm btn-outline-secondary">View Details</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />
                    <input type="hidden" asp-for="OpportunityCode" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label"></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                                <option value="">-- None / Direct Customer --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" class="form-control" id="oppAmount" type="number" step="0.01" oninput="calcWeighted()" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" id="oppProb" type="number" min="0" max="100" oninput="calcWeighted()" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="p-2 bg-light border rounded small d-flex justify-content-between align-items-center">
                                <span>Weighted Pipeline Value (Amount &times; Probability / 100):</span>
                                <strong class="text-primary fs-6" id="weightedPreview">$0</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label"></label>
                            <select asp-for="Stage" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ExpectedCloseDate" class="form-label"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Open">Open</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole(SystemRoles.Admin) || User.IsInRole(SystemRoles.Manager))
                        {
                            <div class="col-12">
                                <label asp-for="AssignedTo" class="form-label"></label>
                                <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.SalesExecutives">
                                    <option value="">-- Select Sales Executive --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calcWeighted() {
            const amt = parseFloat(document.getElementById('oppAmount').value) || 0;
            const prob = parseFloat(document.getElementById('oppProb').value) || 0;
            const weighted = (amt * prob) / 100;
            document.getElementById('weightedPreview').innerText = '$' + weighted.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        calcWeighted();
    </script>
}
