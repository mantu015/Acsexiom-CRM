@model AcxiomCRM.ViewModels.OpportunityDetailsViewModel
@{
    var opp = Model.Opportunity;
    ViewData["Title"] = $"{opp.OpportunityName} - Opportunity Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h4 class="fw-bold mb-0">@opp.OpportunityName</h4>
            <span class="badge bg-light text-dark border me-2">@opp.OpportunityCode</span>
            <span class="badge @(opp.Stage == "Won" ? "bg-success" : opp.Stage == "Lost" ? "bg-danger" : "bg-primary")">@opp.Stage</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@opp.OpportunityId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-relatedType="Opportunity" asp-route-relatedId="@opp.OpportunityId" class="btn btn-warning btn-sm text-dark">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-opportunityId="@opp.OpportunityId" class="btn btn-light border btn-sm">
            <i class="bi bi-clock-history me-1"></i> Log Activity
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Financial Deal Summary Card -->
    <div class="col-lg-4">
        <div class="crm-card">
            <div class="crm-card-header">
                <h6 class="mb-0 fw-bold"><i class="bi bi-currency-dollar me-2 text-primary"></i> Deal Financials</h6>
            </div>
            <div class="crm-card-body">
                <div class="mb-3">
                    <label class="text-muted small">Total Deal Amount</label>
                    <div class="fs-4 fw-bold text-dark">$@opp.Amount.ToString("N2")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Win Probability</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold">@opp.Probability%</span>
                        <div class="progress flex-grow-1" style="height: 8px;">
                            <div class="progress-bar @(opp.Probability >= 70 ? "bg-success" : opp.Probability >= 40 ? "bg-primary" : "bg-warning")" style="width: @opp.Probability%"></div>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Weighted Pipeline Value (Amount &times; Prob / 100)</label>
                    <div class="fs-5 fw-bold text-primary">$@opp.WeightedValue.ToString("N2")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Customer Account</label>
                    <div>
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@opp.CustomerId" class="fw-semibold text-decoration-none">
                            @opp.Customer?.CustomerName
                        </a>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Expected Close Date</label>
                    <div class="fw-semibold">@opp.ExpectedCloseDate.ToString("MMMM dd, yyyy")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Assigned Sales Executive</label>
                    <div class="fw-semibold text-primary">@(opp.AssignedUser?.FullName ?? "Unassigned")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Created Date</label>
                    <div class="small">@opp.CreatedDate.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(opp.Notes))
                {
                    <div class="pt-2 border-top">
                        <label class="text-muted small">Deal Notes</label>
                        <p class="small text-secondary mb-0">@opp.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Related Follow-Ups and Activities -->
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header p-0 border-bottom-0">
                <ul class="nav nav-tabs px-3 pt-2" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-semibold" data-bs-toggle="tab" data-bs-target="#opp-followups" type="button">
                            Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#opp-activities" type="button">
                            Activities (@Model.Activities.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="crm-card-body">
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="opp-followups">
                        @if (Model.FollowUps.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var f in Model.FollowUps)
                                {
                                    <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-semibold small">@f.Subject</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                <span class="badge bg-light text-dark border me-1">@f.FollowUpType</span>
                                                @f.FollowUpDate.ToString("MMM dd, yyyy HH:mm") &bull; Status: <span class="badge-status @(f.Status == "Completed" ? "badge-completed" : "badge-planned")">@f.Status</span>
                                            </div>
                                        </div>
                                        @if (f.Status == "Planned")
                                        {
                                            <a asp-controller="FollowUps" asp-action="Complete" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-success">Done</a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-calendar-check fs-2 text-secondary d-block mb-1"></i>
                                No follow-ups scheduled for this opportunity.
                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" id="opp-activities">
                        @if (Model.Activities.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var a in Model.Activities)
                                {
                                    <div class="list-group-item px-0 py-2 d-flex align-items-start gap-3">
                                        <div class="badge bg-light text-dark border p-2">@a.ActivityType</div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold small">@a.Subject</div>
                                            @if (!string.IsNullOrWhiteSpace(a.Description))
                                            {
                                                <div class="text-muted small">@a.Description</div>
                                            }
                                            <div class="text-muted" style="font-size: 0.72rem;">@a.ActivityDate.ToString("MMM dd, yyyy HH:mm")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-clock-history fs-2 text-secondary d-block mb-1"></i>
                                No activities recorded for this opportunity.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
