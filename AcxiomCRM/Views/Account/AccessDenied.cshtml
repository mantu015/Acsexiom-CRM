@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-5 mx-auto" style="max-width: 500px;">
        <div class="text-danger mb-3">
            <i class="bi bi-shield-slash fs-1"></i>
        </div>
        <h3 class="fw-bold">Access Denied</h3>
        <p class="text-muted">
            You do not have the required permissions or role privileges to view this page or perform this action.
        </p>
        <div class="mt-4">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>
