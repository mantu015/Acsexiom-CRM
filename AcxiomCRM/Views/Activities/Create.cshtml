@model AcxiomCRM.ViewModels.ActivityFormViewModel
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i> Log Activity</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label"></label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label"></label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label"></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Discovery call regarding cloud requirements" autofocus />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CustomerId" class="form-label"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LeadId" class="form-label"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="OpportunityId" class="form-label"></label>
                            <select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.Opportunities">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="Pending">Pending</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        @if (User.IsInRole(SystemRoles.Admin) || User.IsInRole(SystemRoles.Manager))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label"></label>
                                <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.SalesExecutives">
                                    <option value="">-- Assign to Current User --</option>
                                </select>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Key talking points, meeting notes, action items..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Log Activity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
