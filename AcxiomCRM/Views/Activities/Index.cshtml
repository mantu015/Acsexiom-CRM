@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.Models.Entities.Activity>
@{
    ViewData["Title"] = "Activity Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">CRM Activities</h4>
        <p class="text-muted small mb-0">Record and review customer interactions: Calls, Meetings, Emails, and Tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Log Activity
    </a>
</div>

<!-- Search & Filter Card -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="type" class="form-select">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                    <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                    <option value="Task" selected="@(ViewBag.Type == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                    <option value="Pending" selected="@(ViewBag.Status == "Pending")">Pending</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="date" class="form-control" value="@ViewBag.Date" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Subject & Summary</th>
                    <th>Associated Entity</th>
                    <th>Activity Date</th>
                    <th>Status</th>
                    <th>Logged By / Assignee</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var a in Model.Items)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border p-2">
                                    @if (a.ActivityType == "Call") { <i class="bi bi-telephone text-primary me-1"></i> }
                                    else if (a.ActivityType == "Meeting") { <i class="bi bi-people text-success me-1"></i> }
                                    else if (a.ActivityType == "Email") { <i class="bi bi-envelope text-info me-1"></i> }
                                    else { <i class="bi bi-check2-square text-secondary me-1"></i> }
                                    @a.ActivityType
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@a.Subject</div>
                                @if (!string.IsNullOrWhiteSpace(a.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 380px;">@a.Description</div>
                                }
                            </td>
                            <td>
                                @if (a.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@a.CustomerId" class="badge bg-primary bg-opacity-10 text-primary text-decoration-none">
                                        Customer: @a.Customer.CustomerName
                                    </a>
                                }
                                else if (a.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@a.LeadId" class="badge bg-info bg-opacity-10 text-info text-decoration-none">
                                        Lead: @a.Lead.LeadName
                                    </a>
                                }
                                else if (a.Opportunity != null)
                                {
                                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@a.OpportunityId" class="badge bg-success bg-opacity-10 text-success text-decoration-none">
                                        Opp: @a.Opportunity.OpportunityName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="badge-status @(a.Status == "Completed" ? "badge-completed" : "badge-inactive")">
                                    @a.Status
                                </span>
                            </td>
                            <td>@(a.AssignedUser?.FullName ?? "System")</td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@a.ActivityId" method="post" class="d-inline" onsubmit="return confirm('Delete this activity entry?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-clock-history fs-1 d-block mb-2 text-secondary"></i>
                            No CRM activities found matching criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total records)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
