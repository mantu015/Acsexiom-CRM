@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.Models.Entities.Lead>
@{
    ViewData["Title"] = "Lead Report";
    var filter = ViewBag.Filter as AcxiomCRM.ViewModels.ReportFilterViewModel ?? new AcxiomCRM.ViewModels.ReportFilterViewModel();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Lead Analysis Report</h4>
        <p class="text-muted small mb-0">Overview of inbound and prospective leads, channels, and conversion history</p>
    </div>
</div>

<!-- Navigation Pills -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-2 bg-white rounded-3">
        <ul class="nav nav-pills flex-column flex-sm-row">
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Pipeline"><i class="bi bi-bar-chart-steps me-1"></i> Pipeline</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Customers"><i class="bi bi-people me-1"></i> Customers</a></li>
            <li class="nav-item"><a class="nav-link active" asp-action="Leads"><i class="bi bi-funnel me-1"></i> Leads</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Opportunities"><i class="bi bi-currency-dollar me-1"></i> Opportunities</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="FollowUps"><i class="bi bi-calendar-check me-1"></i> Follow-Ups</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Conversion"><i class="bi bi-arrow-repeat me-1"></i> Conversion</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="UserActivity"><i class="bi bi-person-lines-fill me-1"></i> User Activity</a></li>
            @if (User.IsInRole(SystemRoles.Admin))
            {
                <li class="nav-item"><a class="nav-link text-dark" asp-action="Audit"><i class="bi bi-shield-check me-1"></i> Audit Logs</a></li>
            }
        </ul>
    </div>
</div>

<!-- Filter Bar -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form asp-action="Leads" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="SearchTerm" class="form-control" placeholder="Search by name, company..." value="@filter.SearchTerm" />
            </div>
            <div class="col-md-3">
                <select name="Status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(filter.Status == "New")">New</option>
                    <option value="Contacted" selected="@(filter.Status == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(filter.Status == "Qualified")">Qualified</option>
                    <option value="Converted" selected="@(filter.Status == "Converted")">Converted</option>
                    <option value="Lost" selected="@(filter.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Leads" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Expected Value</th>
                    <th>Converted?</th>
                    <th>Assigned To</th>
                    <th>Created Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var l in Model.Items)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@l.LeadCode</span></td>
                            <td class="fw-semibold">@l.LeadName</td>
                            <td>@(l.CompanyName ?? "-")</td>
                            <td><span class="badge bg-light text-secondary border">@l.Source</span></td>
                            <td><span class="badge-status badge-qualified">@l.Status</span></td>
                            <td class="fw-bold">$@l.ExpectedValue.ToString("N0")</td>
                            <td>
                                @if (l.IsConverted)
                                {
                                    <span class="badge bg-success">Yes (@(l.ConvertedCustomer?.CustomerName ?? "Customer"))</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">No</span>
                                }
                            </td>
                            <td>@(l.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td>@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted">No leads found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
