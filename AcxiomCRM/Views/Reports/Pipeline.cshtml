@{
    ViewData["Title"] = "Sales Pipeline Report";
    var stageData = ViewBag.StageData as List<AcxiomCRM.ViewModels.PipelineReportItem> ?? new List<AcxiomCRM.ViewModels.PipelineReportItem>();
    var ownerData = ViewBag.OwnerData as List<AcxiomCRM.ViewModels.OwnerPipelineReportItem> ?? new List<AcxiomCRM.ViewModels.OwnerPipelineReportItem>();
    var filter = ViewBag.Filter as AcxiomCRM.ViewModels.ReportFilterViewModel ?? new AcxiomCRM.ViewModels.ReportFilterViewModel();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">CRM Reports & Analytics</h4>
        <p class="text-muted small mb-0">Role-scoped executive reporting, pipeline forecasts, and conversion intelligence</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportPipelineCsv" class="btn btn-outline-success shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Pipeline CSV
        </a>
    </div>
</div>

<!-- Navigation Pills between Report Types -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-2 bg-white rounded-3">
        <ul class="nav nav-pills flex-column flex-sm-row">
            <li class="nav-item"><a class="nav-link active" asp-action="Pipeline"><i class="bi bi-bar-chart-steps me-1"></i> Pipeline</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Customers"><i class="bi bi-people me-1"></i> Customers</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Leads"><i class="bi bi-funnel me-1"></i> Leads</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Opportunities"><i class="bi bi-currency-dollar me-1"></i> Opportunities</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="FollowUps"><i class="bi bi-calendar-check me-1"></i> Follow-Ups</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Conversion"><i class="bi bi-arrow-repeat me-1"></i> Conversion</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="UserActivity"><i class="bi bi-person-lines-fill me-1"></i> User Activity</a></li>
            @if (User.IsInRole(SystemRoles.Admin))
            {
                <li class="nav-item"><a class="nav-link text-dark" asp-action="Audit"><i class="bi bi-shield-check me-1"></i> Audit Logs</a></li>
            }
        </ul>
    </div>
</div>

<!-- Stage-wise Pipeline Report -->
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="crm-card h-100">
            <div class="crm-card-header">
                <h6 class="mb-0 fw-bold"><i class="bi bi-funnel-fill me-2 text-primary"></i> Stage-Wise Pipeline Breakdown</h6>
            </div>
            <div class="table-responsive">
                <table class="table crm-table">
                    <thead>
                        <tr>
                            <th>Pipeline Stage</th>
                            <th>Count</th>
                            <th>Total Amount ($)</th>
                            <th>Weighted Value ($)</th>
                            <th>Pipeline %</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in stageData)
                        {
                            <tr>
                                <td>
                                    <span class="badge @(s.Stage == "Won" ? "bg-success" : s.Stage == "Lost" ? "bg-danger" : "bg-primary")">
                                        @s.Stage
                                    </span>
                                </td>
                                <td class="fw-semibold">@s.Count</td>
                                <td class="fw-bold text-dark">$@s.TotalAmount.ToString("N2")</td>
                                <td class="fw-semibold text-primary">$@s.WeightedAmount.ToString("N2")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span>@s.PercentageOfPipeline%</span>
                                        <div class="progress flex-grow-1" style="height: 6px; width: 40px;">
                                            <div class="progress-bar bg-primary" style="width: @s.PercentageOfPipeline%"></div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td>Total Pipeline</td>
                            <td>@stageData.Sum(s => s.Count)</td>
                            <td class="text-dark">$@stageData.Sum(s => s.TotalAmount).ToString("N2")</td>
                            <td class="text-primary">$@stageData.Sum(s => s.WeightedAmount).ToString("N2")</td>
                            <td>100%</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Owner-wise Pipeline Report -->
    <div class="col-lg-5">
        <div class="crm-card h-100">
            <div class="crm-card-header">
                <h6 class="mb-0 fw-bold"><i class="bi bi-people-fill me-2 text-primary"></i> Owner-Wise Deal Distribution</h6>
            </div>
            <div class="table-responsive">
                <table class="table crm-table">
                    <thead>
                        <tr>
                            <th>Sales Executive</th>
                            <th>Deals</th>
                            <th>Total Pipeline ($)</th>
                            <th>Weighted ($)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ownerData.Any())
                        {
                            @foreach (var o in ownerData)
                            {
                                <tr>
                                    <td class="fw-semibold">@o.OwnerName</td>
                                    <td>@o.OpportunityCount</td>
                                    <td class="fw-bold text-dark">$@o.TotalAmount.ToString("N0")</td>
                                    <td class="text-primary fw-semibold">$@o.WeightedAmount.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-4 text-muted">No owner data available.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
