@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Security & Audit Report";
    var filter = ViewBag.Filter as AcxiomCRM.ViewModels.ReportFilterViewModel ?? new AcxiomCRM.ViewModels.ReportFilterViewModel();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Security & Audit Report</h4>
        <p class="text-muted small mb-0">Append-only audit trail tracking security events, authentication attempts, and data operations</p>
    </div>
</div>

<!-- Navigation Pills -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-2 bg-white rounded-3">
        <ul class="nav nav-pills flex-column flex-sm-row">
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Pipeline"><i class="bi bi-bar-chart-steps me-1"></i> Pipeline</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Customers"><i class="bi bi-people me-1"></i> Customers</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Leads"><i class="bi bi-funnel me-1"></i> Leads</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Opportunities"><i class="bi bi-currency-dollar me-1"></i> Opportunities</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="FollowUps"><i class="bi bi-calendar-check me-1"></i> Follow-Ups</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Conversion"><i class="bi bi-arrow-repeat me-1"></i> Conversion</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="UserActivity"><i class="bi bi-person-lines-fill me-1"></i> User Activity</a></li>
            <li class="nav-item"><a class="nav-link active" asp-action="Audit"><i class="bi bi-shield-check me-1"></i> Audit Logs</a></li>
        </ul>
    </div>
</div>

<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table">
            <thead>
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Details</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var log in Model.Items)
                    {
                        <tr>
                            <td class="small">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-semibold">@(log.UserName ?? "System")</td>
                            <td>
                                <span class="badge @(log.Action.Contains("Login") ? "bg-info" : log.Action == "Delete" ? "bg-danger" : "bg-secondary")">
                                    @log.Action
                                </span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@log.EntityName</span></td>
                            <td class="small text-muted" style="max-width: 400px;">@(log.Details ?? log.NewValue ?? "-")</td>
                            <td>
                                <span class="badge @(log.Result == "Success" ? "bg-success" : "bg-danger")">
                                    @log.Result
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center py-4 text-muted">No audit entries found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
