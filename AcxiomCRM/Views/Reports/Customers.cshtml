@model AcxiomCRM.ViewModels.Common.PagedResult<AcxiomCRM.Models.Entities.Customer>
@{
    ViewData["Title"] = "Customer Report";
    var filter = ViewBag.Filter as AcxiomCRM.ViewModels.ReportFilterViewModel ?? new AcxiomCRM.ViewModels.ReportFilterViewModel();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1">Customer Report</h4>
        <p class="text-muted small mb-0">Detailed master list of customer accounts, owners, and account statuses</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCustomersCsv" asp-route-status="@filter.Status" asp-route-searchTerm="@filter.SearchTerm" class="btn btn-outline-success shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Customers CSV
        </a>
    </div>
</div>

<!-- Navigation Pills -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-2 bg-white rounded-3">
        <ul class="nav nav-pills flex-column flex-sm-row">
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Pipeline"><i class="bi bi-bar-chart-steps me-1"></i> Pipeline</a></li>
            <li class="nav-item"><a class="nav-link active" asp-action="Customers"><i class="bi bi-people me-1"></i> Customers</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Leads"><i class="bi bi-funnel me-1"></i> Leads</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Opportunities"><i class="bi bi-currency-dollar me-1"></i> Opportunities</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="FollowUps"><i class="bi bi-calendar-check me-1"></i> Follow-Ups</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="Conversion"><i class="bi bi-arrow-repeat me-1"></i> Conversion</a></li>
            <li class="nav-item"><a class="nav-link text-dark" asp-action="UserActivity"><i class="bi bi-person-lines-fill me-1"></i> User Activity</a></li>
            @if (User.IsInRole(SystemRoles.Admin))
            {
                <li class="nav-item"><a class="nav-link text-dark" asp-action="Audit"><i class="bi bi-shield-check me-1"></i> Audit Logs</a></li>
            }
        </ul>
    </div>
</div>

<!-- Filter Bar -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form asp-action="Customers" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="SearchTerm" class="form-control" placeholder="Search by name, company, email..." value="@filter.SearchTerm" />
            </div>
            <div class="col-md-3">
                <select name="Status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(filter.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(filter.Status == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Apply Filters</button>
                <a asp-action="Customers" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Report Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th>Created Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                            <td class="fw-semibold">@c.CustomerName</td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@(c.City ?? "-"), @(c.State ?? "")</td>
                            <td>
                                <span class="badge-status @(c.Status == "Active" ? "badge-active" : "badge-inactive")">
                                    @c.Status
                                </span>
                            </td>
                            <td>@(c.Owner?.FullName ?? "Unassigned")</td>
                            <td>@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted">No records match the report criteria.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Customers" asp-route-PageNumber="@(Model.PageNumber - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Customers" asp-route-PageNumber="@p">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Customers" asp-route-PageNumber="@(Model.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
